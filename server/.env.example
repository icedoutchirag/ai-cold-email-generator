# Server Port (Default is 5001 for development, or 5000)
PORT=5001

# MongoDB Connection String (Atlas or local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai-cold-email?retryWrites=true&w=majority

# JWT Secret Key for token signing
JWT_SECRET=your_super_secret_jwt_key_here_at_least_32_characters

# Groq API Key (free fast LLM: https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Frontend Application URL (for CORS)
FRONTEND_URL=http://localhost:5173

# --- Email Provider Configurations (At least one is needed for OTP verification) ---

# Option A: Brevo (Recommended for free cloud deployment: 300 emails/day, verify sender at https://app.brevo.com/senders)
BREVO_API_KEY=xkeysib_your_brevo_api_key_here

# Option B: Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=no-reply@yourdomain.com

# Option C: Gmail SMTP (Local/VPS only - blocked by Vercel serverless)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_digit_google_app_password
